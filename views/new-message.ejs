<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
</head>
<body>
  <h1>Create a New Message</h1>

  <% if (locals.errors) { %>
    <ul style="color: red;">
      <% errors.forEach(error => { %>
        <li><%= error.msg %></li>
      <% }) %>
    </ul>
  <% } %>

  <form action="/new-message" method="POST">
    <div>
      <label for="title">Title:</label>
      <input type="text" id="title" name="title" required value="<%= locals.formData ? formData.title : '' %>">
    </div>

    <div>
      <label for="text">Message:</label>
      <textarea id="text" name="text" rows="5" required><%= locals.formData ? formData.text : '' %></textarea>
    </div>

    <button type="submit">Post Message</button>
  </form>

  <p><a href="/">Back to Home</a></p>
</body>
</html>