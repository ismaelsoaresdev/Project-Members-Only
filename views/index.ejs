<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="container">
    <header class="header">
      <h1>Welcome to Clubhouse</h1>

      <% if (currentUser) { %>
        <div class="user-info">
          <h2>Welcome back, <%= currentUser.first_name %> <%= currentUser.last_name %>!</h2>
          <p>
            <strong>Status:</strong> 
            <span class="badge <%= currentUser.membership_status ? 'badge-member' : 'badge-non-member' %>">
              <%= currentUser.membership_status ? "Club Member" : "Non-Member" %>
            </span>
          </p>
          
          <% if (!currentUser.membership_status) { %>
            <p><a href="/join-club" class="btn btn-secondary">Enter Secret Code to Become a Member</a></p>
          <% } %>

          <nav class="nav-links">
            <a href="/new-message" class="btn btn-primary">Create New Message</a>
            <a href="/log-out" class="btn btn-outline">Log Out</a>
          </nav>
        </div>
      <% } else { %>
        <div class="auth-prompt">
          <p>You are not logged in.</p>
          <nav class="nav-links">
            <a href="/sign-up" class="btn btn-primary">Sign Up</a>
            <a href="/log-in" class="btn btn-secondary">Log In</a>
          </nav>
        </div>
      <% } %>
    </header>

    <hr>

    <main class="feed-section">
      <h2>Clubhouse Feed</h2>

      <% if (messages && messages.length > 0) { %>
        <div class="messages-list">
          <% messages.forEach(message => { %>
            <div class="card message-card">
              <div class="card-header">
                <h3><%= message.title %></h3>
              </div>
              <div class="card-body">
                <p class="message-text"><%= message.text %></p>
              </div>
              <div class="card-footer">
                <% if (currentUser && currentUser.membership_status) { %>
                  <p><small><strong>Author:</strong> <%= message.first_name %> <%= message.last_name %> (@<%= message.username %>)</small></p>
                  <p><small><strong>Date:</strong> <%= new Date(message.timestamp).toLocaleString() %></small></p>
                <% } else { %>
                  <p><small><strong>Author:</strong> <em>Anonymous (Members Only)</em></small></p>
                  <p><small><strong>Date:</strong> <em>Hidden (Members Only)</em></small></p>
                <% } %>

                <% if (currentUser && currentUser.is_admin) { %>
                  <form action="/message/<%= message.id %>/delete" method="POST" class="delete-form">
                    <button type="submit" onclick="return confirm('Are you sure you want to delete this message?');" class="btn btn-danger">
                      Delete Message
                    </button>
                  </form>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <p class="empty-feed">No messages posted yet.</p>
      <% } %>
    </main>
  </div>
</body>
</html>